# Stripe test-mode API key (from https://dashboard.stripe.com/test/apikeys)
# Prefer a restricted key (rk_test_...) scoped to Checkout Sessions + Webhooks
# over the full secret key (sk_test_...) where possible.
# Required by app/api/create-checkout-session/route.ts
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret for app/api/webhooks/stripe/route.ts
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and use the whsec_... value it prints.
# Production: from the endpoint's settings at https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: only needed if you later add client-side Stripe.js (Elements, etc.)
STRIPE_PUBLISHABLE_KEY=pk_test_...
